{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Growth Buddies Light",
  "version": "1.0.0",
  "description": "Light theme of the Growth Buddies design system, shared by every \"buddies\" app. Derived from the dark web tokens (bg #0B0B0F, line #232330, muted #A7A7B2, accent #0097B2, accent-dark #005E70).",
  "color": {
    "teal": {
      "50": "#E8F7FA", "100": "#CCEEF4", "200": "#99DDE9", "300": "#5CCADD", "400": "#00B5D6",
      "500": "#00A5C3", "600": "#0097B2", "700": "#007C93", "800": "#005E70", "900": "#0A4552", "950": "#062B34"
    },
    "ink": {
      "50": "#F6F6F8", "100": "#ECECEF", "200": "#DCDCE3", "300": "#C4C4CE", "400": "#A7A7B2",
      "500": "#6E6E7A", "600": "#55555F", "700": "#3A3A45", "800": "#232330", "900": "#14141A", "950": "#0B0B0F"
    },
    "status": {
      "success": "#15803D", "success-soft": "#DCFCE7",
      "warning": "#B45309", "warning-soft": "#FEF3C7",
      "danger": "#DC2626", "danger-soft": "#FEE2E2",
      "info": "#007C93", "info-soft": "#E8F7FA"
    }
  },
  "semantic": {
    "bg": "{color.ink.50}",
    "surface": "#FFFFFF",
    "surface-muted": "{color.ink.100}",
    "line": "{color.ink.200}",
    "line-strong": "{color.ink.300}",
    "fg": "{color.ink.950}",
    "fg-secondary": "{color.ink.600}",
    "fg-muted": "{color.ink.500}",
    "fg-disabled": "{color.ink.400}",
    "brand": "{color.teal.600}",
    "brand-soft": "{color.teal.50}",
    "action": "{color.teal.700}",
    "action-hover": "{color.teal.800}",
    "on-action": "#FFFFFF",
    "link": "{color.teal.700}",
    "focus-ring": "{color.teal.400}",
    "brand-gradient": "linear-gradient(135deg, #00B5D6 0%, #0097B2 45%, #005E70 100%)"
  },
  "font": {
    "sans": "Inter, system-ui, sans-serif",
    "heading": "Geist, Inter, system-ui, sans-serif"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "app-icon": "22.5%" },
  "tenantPalette": {
    "description": "Mapping for apps whose Tailwind `brand` scale uses 600 for primary buttons (e.g. Expense Buddy tenants/<id>.json branding.palette): 600 must carry white text at AA, so it is teal-700.",
    "50": "#E8F7FA", "100": "#CCEEF4", "500": "#0097B2", "600": "#007C93", "700": "#005E70", "800": "#0A4552", "900": "#062B34",
    "themeColor": "#0097B2"
  }
}
