{
  "name": "expense-buddy-functions",
  "private": true,
  "version": "0.1.0",
  "description": "Cloud Functions backend for Expense Buddy tenants",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
