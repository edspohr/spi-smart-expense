# Firebase web config of the demo tenant project (expense-buddy-demo).
# Copy to .env.demo and fill from Firebase console → Project settings → Your apps.
VITE_TENANT=demo
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=expense-buddy-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=expense-buddy-demo
VITE_FIREBASE_STORAGE_BUCKET=expense-buddy-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_RECAPTCHA_SITE_KEY=
VITE_FCM_VAPID_KEY=
