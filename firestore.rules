rules_version = '2';

// Authorisation reads custom claims (role, active, permission flags) that the
// onUserWritten Cloud Function mirrors from users/{uid}. No get()/exists()
// lookups: rules stay cheap and cannot diverge from the user doc.
//
// Money fields (users.balance, projects.expenses) and status transitions are
// written only by Cloud Functions: clients may create/edit/delete expenses
// but never change `status`, and may not touch aggregates.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity helpers
    function isAuth() { return request.auth != null; }
    function claims() { return request.auth.token; }
    function role() { return isAuth() && ('role' in claims()) ? claims().role : null; }
    function isActive() { return isAuth() && claims().get('active', true) != false; }
    function isAdmin() { return isActive() && role() in ['admin', 'superadmin']; }
    function isSuperadmin() { return isActive() && role() == 'superadmin'; }
    function isAssistant() { return isActive() && role() == 'assistant'; }
    function hasFlag(name) { return isActive() && claims().get(name, false) == true; }
    function isSelf(uid) { return isAuth() && request.auth.uid == uid; }

    function incoming() { return request.resource.data; }
    function changedKeys() { return incoming().diff(resource.data).affectedKeys(); }
    function unchanged(field) { return incoming().get(field, null) == resource.data.get(field, null); }

    // ---------- Schema
    function validStatus(s) { return s in ['pending', 'approved', 'rejected']; }
    function validCurrency(c) { return c in ['COP', 'USD', 'EUR', 'CLP']; }
    function nullableNumber(d, f) { return !(f in d) || d[f] == null || d[f] is number; }
    function nullableString(d, f) { return !(f in d) || d[f] == null || d[f] is string; }

    function validExpense(d) {
      return d.userId is string && d.userId.size() > 0
        && d.amount is number && d.amount > 0
        && validCurrency(d.get('currency', 'COP'))
        && validStatus(d.get('status', 'pending'))
        && d.date is string && d.date.size() > 0
        && d.createdAt is string
        && nullableString(d, 'projectId')
        && nullableNumber(d, 'amountCOP')
        && nullableNumber(d, 'trm')
        && (!('isCompanyExpense' in d) || d.isCompanyExpense is bool);
    }

    function isColombiaExpense() { return resource.data.get('currency', 'COP') == 'COP'; }
    function canReviewCurrent() {
      return isAdmin()
        || (hasFlag('canApprove') && !isColombiaExpense())
        || (hasFlag('isColombiaApprover') && isColombiaExpense());
    }

    // ---------- users
    match /users/{userId} {
      allow read: if isActive();
      // Self-registration: always a professional with a zero balance. Roles,
      // permissions and bootstrap admins are set server-side (scripts/Functions).
      allow create: if isSelf(userId)
        && incoming().get('role', 'professional') == 'professional'
        && !('permissions' in incoming())
        && incoming().get('balance', 0) == 0;
      // Privilege fields belong to superadmins (normally via the
      // adminUpdateUser callable); admins keep editing the rest (e.g. balance
      // adjustments from allocations). Nobody changes their own privileges.
      allow update: if (isSuperadmin() && !(isSelf(userId) && changesPrivileges()))
        || (isAdmin() && !changesPrivileges())
        || (isSelf(userId)
            && changedKeys().hasOnly(['displayName', 'photoURL', 'forcePasswordChange', 'fcmTokens', 'notificationPrefs', 'updatedAt']));
      allow delete: if isSuperadmin() && !isSelf(userId);

      function changesPrivileges() {
        return changedKeys().hasAny(['role', 'permissions', 'active', 'managerUid', 'requiresApproval', 'tenantId']);
      }
    }

    // ---------- runtime tenant settings (PIN toggle, modules, AI limits)
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isSuperadmin();
    }

    // ---------- projects (cost centers)
    match /projects/{projectId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && unchangedOrAbsentExpenses();
      allow delete: if isAdmin();

      function unchangedOrAbsentExpenses() {
        // `expenses` is maintained by onExpenseWritten; admins may seed it at
        // creation (0) but not edit it afterwards.
        return resource == null || unchanged('expenses');
      }
    }

    // ---------- expenses
    match /expenses/{expenseId} {
      // pendingApproverUids: the manager (and delegate) of the current
      // approval step, set server-side when the tenant uses levels.
      allow read: if isActive()
        && (resource.data.userId == request.auth.uid
            || canReviewCurrent()
            || request.auth.uid in resource.data.get('pendingApproverUids', []));

      allow create: if isActive()
        && validExpense(incoming())
        && incoming().get('status', 'pending') == 'pending'
        && !incoming().keys().hasAny(['approvalFlow', 'pendingApproverUids', 'reviewedAt', 'reviewedByUid'])
        && (incoming().userId == request.auth.uid || isAdmin() || isAssistant());

      allow update: if isActive()
        && validExpense(incoming())
        && unchanged('status')
        && unchanged('createdAt')
        && unchanged('approvalFlow')
        && unchanged('pendingApproverUids')
        && (canReviewCurrent()
            || (resource.data.userId == request.auth.uid
                && resource.data.get('status', 'pending') == 'pending'
                && unchanged('userId')));

      // Owners delete their own pending expenses directly; any other delete
      // goes through the deleteExpense callable so the PIN can be enforced.
      allow delete: if isActive()
        && resource.data.userId == request.auth.uid
        && resource.data.get('status', 'pending') == 'pending';

      // Append-only audit trail; Functions write the status entries.
      match /movements/{movementId} {
        allow read: if isActive();
        allow create: if isActive() && incoming().byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- allocations
    match /allocations/{allocationId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- invoices
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // ---------- notifications
    match /notifications/{notifId} {
      allow read: if isActive() && resource.data.toUid == request.auth.uid;
      allow update: if isActive() && resource.data.toUid == request.auth.uid
        && changedKeys().hasOnly(['read']);
      allow create: if isActive()
        && incoming().toUid is string
        && incoming().get('read', false) == false;
      allow delete: if false;
    }

    // ---------- server-only collections
    match /rateLimits/{doc} { allow read, write: if false; }
    match /userPins/{doc} { allow read, write: if false; }
    match /pinLog/{doc} { allow read, write: if false; }
    match /mailQueue/{doc} { allow read, write: if false; }
    match /aggregateLedger/{doc} { allow read, write: if false; }
  }
}
