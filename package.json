{
  "name": "spi-smart-expense",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src/ --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "build:demo": "VITE_TENANT=demo vite build",
    "functions:build": "npm --prefix functions run build",
    "icons": "python3 scripts/generate-icons.py spi && python3 scripts/generate-icons.py demo",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" npm run functions:build && PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --only auth,firestore,storage,functions --project spi-smart-expense --export-on-exit ./emulator-data",
    "emulators:resume": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" npm run functions:build && PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --only auth,firestore,storage,functions --project spi-smart-expense --import ./emulator-data --export-on-exit ./emulator-data",
    "seed:emu": "node scripts/seed-emulator.mjs",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "test:rules": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only firestore --project rules-test-expense-buddy \"vitest --run --config vitest.rules.config.ts\"",
    "claims:backfill": "node scripts/migrations/002-backfill-claims.mjs",
    "vertex:check": "node scripts/vertex-check.mjs",
    "superadmin:bootstrap": "node scripts/bootstrap-superadmin.mjs",
    "migrate:003": "node scripts/migrations/003-users-active-tenant.mjs"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "framer-motion": "^12.26.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "recharts": "3.8.1",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
