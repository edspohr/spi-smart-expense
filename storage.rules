rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function token() { return request.auth.token; }
    function isActive() { return request.auth != null && token().get('active', true) != false; }
    function isAdmin() { return isActive() && token().get('role', '') in ['admin', 'superadmin']; }
    function isApprover() {
      return isActive()
        && (token().get('canApprove', false) == true || token().get('isColombiaApprover', false) == true);
    }

    match /receipts/{userId}/{fileName} {
      // Owner, admins and designated approvers may read; roles come from
      // custom claims (see functions/src/claims.ts), not a Firestore lookup.
      allow read: if isActive() && (request.auth.uid == userId || isAdmin() || isApprover());
      allow write: if isActive()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
