VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Tenant to build (tenants/<id>.json). Defaults to spi.
VITE_TENANT=spi

# Set to true (or use `npm run dev:emu`) to talk to the local Firebase Emulator Suite.
VITE_USE_EMULATORS=false

# App Check (reCAPTCHA Enterprise site key from Firebase console → App Check).
# Leave empty until the key is registered; App Check is then skipped.
VITE_RECAPTCHA_SITE_KEY=
# Only for environments where reCAPTCHA cannot run (CI); register the token in App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# Web push (Firebase console → Project settings → Cloud Messaging → Web Push
# certificates → key pair). Leave empty to hide the push toggle.
VITE_FCM_VAPID_KEY=

# Gemini runs server-side through Vertex AI with IAM (no API key anywhere).
# Emulators use your gcloud Application Default Credentials:
#   gcloud auth application-default login
# (VITE_GEMINI_API_KEY is no longer read by the client.)
