rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{userId}/{fileName} {
      // Read allowed for:
      //   - the owner (path segment matches auth uid)
      //   - admins (role == 'admin' in Firestore users doc)
      //   - explicit approvers (permissions.canApprove == true), covering
      //     the assistant/professional accounts that finance has granted
      //     approval rights via permissions.js.
      // The previous rule granted read to any authenticated user, exposing
      // every uploaded receipt to the entire org.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin' ||
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.permissions.canApprove == true
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
