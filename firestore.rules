rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is assistant
    function isAssistant() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'assistant';
    }

    // Helper: user has canApprove permission flag explicitly set to true
    function hasCanApprove() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('canApprove', false) == true;
    }

    // Helper: user has isColombiaApprover permission flag explicitly set to true
    function hasColombiaApprover() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('isColombiaApprover', false) == true;
    }

    // Helper: expense is a Colombia (COP) expense
    function isColombiaExpense() {
      return resource.data.get('currency', 'COP') == 'COP';
    }

    // Users: 
    // - Read: Authenticated users (to find others for 'on behalf' logic if needed, or profile).
    // - Create: User can create own doc, but role defaults to professional/cannot be admin.
    // - Update: User can update own doc but CANNOT change role. Admin can update everything.
    match /users/{userId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null && request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'professional');
        
      allow update: if request.auth != null && (
        (request.auth.uid == userId && (
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )) || 
        isAdmin()
      );
    }
    
    // Projects: Read assigned/authenticated, Write Admin only
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Expenses: Create/Read own, Admin read/write all
    match /expenses/{expenseId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin() || isAssistant());
      // Admin can update/delete any expense; submitter can update their own pending expenses;
      // users with canApprove may update non-COP expenses; isColombiaApprover may update COP expenses.
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid && resource.data.status == 'pending') ||
        (hasCanApprove() && !isColombiaExpense()) ||
        (hasColombiaApprover() && isColombiaExpense());
      allow delete: if isAdmin();

      // Movements subcollection: append-only audit log.
      // Any authenticated user may create (log a change); nobody may edit or delete.
      match /movements/{movementId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Allocations: Read own (or associated project?), Write Admin only
    match /allocations/{allocationId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Invoices: Admin only
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // Notifications: users read/update their own; any signed-in user may create
    // (approvers notify submitters); no deletes.
    match /notifications/{notifId} {
      allow read, update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if false;
    }
  }
}
