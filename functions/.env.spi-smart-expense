# Cloud Functions params for the SPI tenant (project spi-smart-expense).
# Read by firebase-functions/params at deploy time and by the emulator; one
# file per tenant project. FUNCTIONS_REGION matches the Firestore location
# and tenants/spi.json functionsRegion.
FUNCTIONS_REGION=southamerica-east1
TENANT_ID=spi
BASE_CURRENCY=COP
VERTEX_LOCATION=global
GEMINI_DAILY_LIMIT_USER=60
GEMINI_DAILY_LIMIT_TENANT=1500
TIMEZONE=America/Bogota
# Transactional email (Brevo). Off until the owner sets the BREVO_API_KEY
# secret and a verified sender, then: EMAIL_PROVIDER=brevo, EMAIL_FROM=<sender>.
EMAIL_PROVIDER=none
EMAIL_FROM=
APP_NAME=SPI Smart Expense
APP_URL=https://spi-smart-expense.web.app
BRAND_COLOR=#2563eb
COUNTRY=CO
SCHEDULER_REGION=southamerica-east1
